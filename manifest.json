{
  "manifest_version": 3,
  "name": "UI Blocker Pro",
  "version": "1.2",
  "minimum_chrome_version": "121",
  "description": "Fade or hide distracting UI elements, images and videos on any site with opacity sliders, custom CSS selectors and per-domain rules.",
  "homepage_url": "https://github.com/sandeshPatel06/ui-blocker-pro",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ui-blocker-pro@firefox-extension.dev",
      "strict_min_version": "121.0"
    }
  }
}